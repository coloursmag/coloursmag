<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# 자식 템플릿의 {% set %} 은 레이아웃까지 오지 않아서 프론트매터 값을 직접 씁니다 #}
{% set pTitle = pageTitle or title %}
{% set metaTitle %}{% if pTitle %}{{ pTitle }} — {{ site.title }}{% else %}{{ site.title }} — {{ site.tagline }}{% endif %}{% endset %}
{% set metaDesc = pageDescription or dek or site.description %}
{% set metaImage = image or cover or "/assets/issue1-cover.jpg" %}
<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc }}">
<link rel="canonical" href="{{ siteUrl }}{{ page.url }}">

{# 카카오톡·페이스북·네이버 블로그에 링크를 붙였을 때 뜨는 미리보기 #}
<meta property="og:type" content="{{ 'article' if layout == 'article.njk' else 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pTitle or site.title }}">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:url" content="{{ siteUrl }}{{ page.url }}">
<meta property="og:image" content="{{ siteUrl }}{{ metaImage }}">
<meta property="og:locale" content="ko_KR">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pTitle or site.title }}">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ siteUrl }}{{ metaImage }}">

<meta name="robots" content="index,follow,max-image-preview:large">
{# 구글·네이버 소유확인 — 관리자 → 사이트 설정에서 코드를 붙여 넣으면 켜집니다 #}
{% if site.googleVerification %}<meta name="google-site-verification" content="{{ site.googleVerification }}">{% endif %}
{% if site.naverVerification %}<meta name="naver-site-verification" content="{{ site.naverVerification }}">{% endif %}
<meta name="author" content="{{ author or site.title }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ siteUrl }}/feed.xml">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,400..900;1,62..125,400..900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<link rel="stylesheet" href="/style.css">

{# 검색엔진이 "이건 잡지다 / 이건 기사다" 로 이해하도록 알려줍니다 #}
{% if layout == "article.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": {{ title | dump | safe }},
  "description": {{ (dek or site.description) | dump | safe }},
  "image": ["{{ siteUrl }}{{ image }}"],
  "datePublished": "{{ date | isoDate }}",
  "author": { "@type": "Person", "name": {{ (author or "편집부") | dump | safe }} },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.title | dump | safe }},
    "url": "{{ siteUrl }}/"
  },
  "mainEntityOfPage": "{{ siteUrl }}{{ page.url }}",
  "inLanguage": "ko-KR"
}
</script>
{% elif layout == "product.njk" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ name | dump | safe }},
  "description": {{ (dek or site.description) | dump | safe }},
  "image": ["{{ siteUrl }}{{ cover }}"],
  "isbn": "{{ isbn }}",
  "brand": { "@type": "Brand", "name": {{ site.title | dump | safe }} },
  "offers": {
    "@type": "Offer",
    "url": "{{ siteUrl }}{{ page.url }}",
    "priceCurrency": "KRW",
    "price": "{{ price }}",
    "availability": "https://schema.org/{{ 'OutOfStock' if soldOut else 'InStock' }}"
  }
}
</script>
{% else %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Periodical",
  "name": {{ site.title | dump | safe }},
  "description": {{ site.description | dump | safe }},
  "url": "{{ siteUrl }}/",
  "issn": "",
  "inLanguage": "ko-KR"
}
</script>
{% endif %}
</head>
<body>

<a class="skip" href="#main">본문 바로가기</a>

<header class="head" id="head">
  <div class="head-in">
    <a class="mark" href="/">{{ site.title }}{% if site.markSuffix %}<span>({{ site.markSuffix }})</span>{% endif %}</a>
    <nav class="mini" aria-label="주요 메뉴">
      <a href="/about/">ABOUT</a>
      <a href="/"{% if isHome %} aria-current="page"{% endif %}>MAGAZINE</a>
      <a href="{{ site.instagram or '#' }}"{% if site.instagram %} target="_blank" rel="noopener"{% endif %}>INSTAGRAM</a>
      <a href="#">KO</a>
    </nav>
  </div>

  <p class="tagline">{{ site.description }}</p>

  {% if not hideFilters %}
  <div class="filters">
    <div class="row">
      <a class="chip shop" href="/shop/"{% if isShop %} aria-current="page"{% endif %}>SHOP</a>
      {% for f in site.forms %}
      <a class="chip" href="/?form={{ f | lower }}" data-form="{{ f }}" aria-pressed="false">{{ f }}</a>
      {% endfor %}
      {% for t in site.topics %}
      <a class="chip" href="/?topic={{ t | lower }}" data-topic="{{ t }}" aria-pressed="false">{{ t }}</a>
      {% endfor %}
      <a class="chip reset" href="/" data-reset>전체 보기</a>
    </div>
  </div>
  {% endif %}
</header>

{{ content | safe }}

<footer>
  <span>© 2026 {{ site.title }} magazine</span>
  <span>{{ site.businessInfo }}</span>
</footer>

<div class="toast" id="toast"></div>

{# 관리자 초대 메일의 링크는 사이트 첫 화면으로 떨어집니다.
   이 위젯이 없으면 비밀번호를 정하는 창이 뜨지 않아 로그인을 못 합니다. #}
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
if (window.netlifyIdentity) {
  window.netlifyIdentity.on("init", function (user) {
    if (!user) {
      window.netlifyIdentity.on("login", function () {
        document.location.href = "/admin/";
      });
    }
  });
}
</script>

<script>
// 스크롤하면 제호가 줄어들며 분류 칩만 남아 고정됩니다
(function(){
  var head = document.getElementById('head');
  if(head) addEventListener('scroll', function(){
    head.classList.toggle('small', scrollY > 120);
  }, {passive:true});
})();

// 짧은 알림
function toast(msg){
  var t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(window._tt);
  window._tt = setTimeout(function(){ t.classList.remove('show') }, 2000);
}
</script>
</body>
</html>
