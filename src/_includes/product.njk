---
layout: base.njk
hideFilters: true
---
{% set gallery = shots if shots and shots.length else [cover] %}
<main id="main">
  <article class="pd">
    <div class="pd-shots">
      <figure class="pd-main"><img id="pdMain" src="{{ gallery[0] }}" alt="{{ name }}"></figure>
      {% if gallery.length > 1 %}
      <div class="pd-thumbs">
        {% for g in gallery %}
        <button type="button" class="{{ 'on' if loop.first }}" data-src="{{ g }}" aria-label="이미지 {{ loop.index }}">
          <img src="{{ g }}" alt="" loading="lazy">
        </button>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="pd-info">
      <p class="cat">{{ volume }} {{ season }} · {{ status }}</p>
      <h1>{{ name or keyword }}</h1>
      {% if dek %}<p class="pd-dek">{{ dek }}</p>{% endif %}
      <p class="pd-price"><b>{{ price | won }}원</b><span class="off">+ 배송비 {{ shipping | won }}원</span></p>

      <dl class="pd-spec">
        <div><dt>판형</dt><dd>{{ size }}</dd></div>
        <div><dt>분량</dt><dd>{{ pages }}</dd></div>
        <div><dt>제본</dt><dd>{{ binding }}</dd></div>
        <div><dt>구성</dt><dd>{{ extra }}</dd></div>
        <div><dt>ISBN</dt><dd>{{ isbn }}</dd></div>
      </dl>

      <div class="pd-total"><span>결제 예정 금액</span><b>{{ (price + shipping) | won }}원</b></div>

      {% if soldOut %}
        <button class="pd-buy ghost" type="button" disabled>품절되었습니다</button>
      {% elif buyUrl %}
        <a class="pd-buy pay" href="{{ buyUrl }}" target="_blank" rel="noopener">주문하기</a>
      {% else %}
        <button class="pd-buy pay" type="button" data-order>주문하기</button>
      {% endif %}

      <details class="pd-bank"{% if not buyUrl %} open{% endif %}>
        <summary>계좌 이체로 주문하기</summary>
        <p>아래 계좌로 <b>{{ (price + shipping) | won }}원</b>을 입금하신 뒤, 인스타그램 DM으로
           <b>입금자명 · 연락처 · 받으실 주소</b>를 보내주시면 순서대로 발송해 드립니다.</p>
        <p class="acct">
          <b>{{ bank }}</b> 예금주 {{ bankHolder }}
          <button type="button" data-copy="{{ bank }}">계좌 복사</button>
        </p>
      </details>
    </div>
  </article>

  {% if about and about.length %}
  <section class="pd-sec">
    <h2>이 책에 대하여</h2>
    <div class="pd-cols">
      <div>{% for t in about %}<p>{{ t }}</p>{% endfor %}</div>
      <div>{% for t in about2 %}<p>{{ t }}</p>{% endfor %}</div>
    </div>
    {% if designNote %}<p class="pd-note"><b>디자인 노트</b>{{ designNote }}</p>{% endif %}
  </section>
  {% endif %}

  {% if toc and toc.length %}
  <section class="pd-sec">
    <h2>목차 — {{ toc.length }}편</h2>
    <ol class="pd-toc">{% for t in toc %}<li><span>{{ loop.index }}</span>{{ t }}</li>{% endfor %}</ol>
  </section>
  {% endif %}

  {% if content %}<section class="pd-sec"><h2>발행인의 글</h2><div class="col">{{ content | safe }}</div></section>{% endif %}
</main>

<script>
(function(){
  var main = document.getElementById('pdMain');
  document.querySelectorAll('.pd-thumbs button').forEach(function(b){
    b.addEventListener('click', function(){
      main.src = b.dataset.src;
      document.querySelectorAll('.pd-thumbs button').forEach(function(x){ x.classList.remove('on') });
      b.classList.add('on');
    });
  });
  var copy = document.querySelector('[data-copy]');
  if(copy) copy.addEventListener('click', function(){
    navigator.clipboard.writeText(copy.dataset.copy).then(function(){ toast('계좌번호가 복사되었습니다') });
  });
  var order = document.querySelector('[data-order]');
  if(order) order.addEventListener('click', function(){
    var d = document.querySelector('.pd-bank');
    d.open = true; d.scrollIntoView({behavior:'smooth', block:'center'});
    toast('계좌 이체로 주문하실 수 있습니다');
  });
})();
</script>
