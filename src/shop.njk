---
layout: base.njk
permalink: /shop/index.html
isShop: true
pageTitle: SHOP
pageDescription: 컬러즈 매거진 인쇄판과 굿즈를 주문하실 수 있습니다.
---
{# 왼쪽에 분류만 세우고 오른쪽을 상품에 통째로 내줍니다 (magazine-b 구조) #}
<main id="main">
  <div class="shop-wrap">
    <aside class="shop-rail" id="shopRail"></aside>
    <div class="shop-list" id="shopList">
      {% for p in collections.products %}
      {% set shots = p.data.shots if p.data.shots and p.data.shots.length else [p.data.cover] %}
      <a class="prod" href="{{ p.url }}"
         data-kind="{{ p.data.kind or '단행본' }}"
         data-price="{{ p.data.price }}"
         data-vol="{{ p.data.volumeNo or 0 }}">
        <div class="pair">
          <figure><img src="{{ shots[0] }}" alt="{{ p.data.name }}" loading="lazy"></figure>
          <figure><img src="{{ shots[1] or shots[0] }}" alt="" loading="lazy"></figure>
        </div>
        <div class="line">
          <span class="l">
            <span>{{ p.data.name }}</span>
            <em>{{ p.data.kind or "단행본" }}</em>
            <span>{{ p.data.price | won }}원{% if p.data.soldOut %}<span class="off">품절</span>{% else %}<span class="off">배송비 {{ p.data.shipping | won }}원</span>{% endif %}</span>
          </span>
          <span class="cart">자세히 보기</span>
        </div>
      </a>
      {% endfor %}
      <p class="empty" id="shopEmpty" hidden>해당하는 상품이 아직 없습니다.</p>
    </div>
  </div>
</main>

<script>
(function(){
  var list  = document.getElementById('shopList');
  var rail  = document.getElementById('shopRail');
  var empty = document.getElementById('shopEmpty');
  var rows  = [].slice.call(list.querySelectorAll('.prod'));
  var kinds = ['전체'];
  rows.forEach(function(r){ if(kinds.indexOf(r.dataset.kind) < 0) kinds.push(r.dataset.kind) });

  var cat = '전체', sort = 'new';
  var SORTS = [['new','신상품순'], ['low','낮은 가격순'], ['high','높은 가격순']];

  function build(){
    rail.innerHTML =
      '<div class="cats">' + kinds.map(function(k){
        return '<button type="button" data-cat="' + k + '" aria-pressed="' + (k === cat) + '">' + k + '</button>';
      }).join('') + '</div>' +
      '<div class="foot">' +
        '<span>전체<b id="shopTotal">0</b></span>' +
        '<span class="sort" id="sortWrap">' +
          '<button type="button" id="sortBtn">정렬 ▾</button>' +
          '<span class="menu">' + SORTS.map(function(s){
            return '<button type="button" data-sort="' + s[0] + '" aria-pressed="' + (s[0] === sort) + '">' + s[1] + '</button>';
          }).join('') + '</span>' +
        '</span>' +
      '</div>';

    rail.querySelectorAll('[data-cat]').forEach(function(b){
      b.addEventListener('click', function(){ cat = b.dataset.cat; build(); apply() });
    });
    document.getElementById('sortBtn').addEventListener('click', function(e){
      e.stopPropagation();
      document.getElementById('sortWrap').classList.toggle('open');
    });
    rail.querySelectorAll('[data-sort]').forEach(function(b){
      b.addEventListener('click', function(){
        sort = b.dataset.sort;
        document.getElementById('sortWrap').classList.remove('open');
        build(); apply();
      });
    });
  }
  document.addEventListener('click', function(){
    var w = document.getElementById('sortWrap');
    if(w) w.classList.remove('open');
  });

  function apply(){
    var shown = rows.filter(function(r){
      var ok = cat === '전체' || r.dataset.kind === cat;
      r.hidden = !ok;
      return ok;
    });
    shown.slice().sort(function(x, y){
      if(sort === 'low')  return (+x.dataset.price) - (+y.dataset.price);
      if(sort === 'high') return (+y.dataset.price) - (+x.dataset.price);
      return (+y.dataset.vol) - (+x.dataset.vol);
    }).forEach(function(r){ list.insertBefore(r, empty) });
    document.getElementById('shopTotal').textContent = shown.length;
    empty.hidden = shown.length > 0;
  }

  build(); apply();
})();
</script>
